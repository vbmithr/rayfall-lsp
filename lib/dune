(library
 (name rayfall)
 (public_name rayfall-lsp.core)
 (libraries yojson uutf unix lsp)
 (foreign_stubs
  (language c)
  (names tree_sitter_runtime rayfall_grammar syntax_stubs)
  (flags
   (:standard -std=c11 -D_DEFAULT_SOURCE))
  (include_dirs
   ../vendor/tree-sitter/lib/include
