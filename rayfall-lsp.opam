# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Semantic navigation and language server for Rayfall"
description:
  "An editor-independent Rayfall analyzer and LSP server. Early prototype: conservative static binding navigation, no project evaluation."
maintainer: ["Vincent Bernardoff"]
authors: ["Vincent Bernardoff"]
license: "MIT"
homepage: "https://github.com/vbmithr/rayfall-lsp"
bug-reports: "https://github.com/vbmithr/rayfall-lsp/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.14" & >= "3.14"}
  "yojson" {>= "2.0"}
  "jsonrpc" {>= "1.20"}
  "lsp" {>= "1.20"}
  "uutf"
  "alcotest" {with-test}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/vbmithr/rayfall-lsp.git"
