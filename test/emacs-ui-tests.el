;;; emacs-ui-tests.el --- Inspection checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'eglot)
(defvar company-mode)
(defvar rayfall-repl-buffer nil)
(defvar rayfall-program)
(defvar rayfall-program-arguments)
(load-file (expand-file-name "../editors/emacs/rayfall-lsp-ui.el"
                             (file-name-directory load-file-name)))
(ert-deftest inspection-discards-stale-replies ()
  (with-temp-buffer
    (insert "ctx")
    (let (callback displayed)
      (cl-letf (((symbol-function 'eglot-managed-p) (lambda () t))
                ((symbol-function 'eglot-hover-eldoc-function)
                 (lambda (cb &rest _) (setq callback cb)))
                ((symbol-function 'rayfall-lsp--display-inspection)
                 (lambda (&rest _) (setq displayed t))))
        (rayfall-lsp-describe-at-point)
        (backward-char)
        (funcall callback "Parameter: ctx")
        (should-not displayed)
        (rayfall-lsp-describe-at-point)
        (insert "x")
        (funcall callback "Parameter: ctx")
        (should-not displayed)
        (rayfall-lsp-describe-at-point)
        (funcall callback "Parameter: ctx")
        (should displayed)))))
(ert-deftest inspection-popup-is-read-only-display ()
  (let (arguments)
    (provide 'posframe)
    (cl-letf (((symbol-function 'posframe-workable-p) (lambda () t))
              ((symbol-function 'posframe-show) (lambda (&rest args) (setq arguments args)))
              ((symbol-function 'posframe-hide) #'ignore))
      (rayfall-lsp--display-inspection "Dictionary fields: cash" nil)
      (should (equal (plist-get (cdr arguments) :string) "Dictionary fields: cash"))
      (should-not (plist-get (cdr arguments) :accept-focus))
      (should (memq #'rayfall-lsp-hide-inspection pre-command-hook))
      (rayfall-lsp-hide-inspection)
      (should-not (memq #'rayfall-lsp-hide-inspection pre-command-hook)))))
(ert-deftest field-completion-only-triggers-after-code-dot ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (let ((company-mode t) (calls 0))
      (cl-letf (((symbol-function 'eglot-managed-p) (lambda () t))
                ((symbol-function 'rayfall-lsp-complete)
                 (lambda () (setq calls (1+ calls)))))
        (insert "bt.")
        (let ((last-command-event ?.)) (rayfall-lsp-complete-after-dot))
        (should (= calls 1))
        (let ((last-command-event ?a)) (rayfall-lsp-complete-after-dot))
        (should (= calls 1))
        (insert "\n; bt.")
        (let ((last-command-event ?.)) (rayfall-lsp-complete-after-dot))
        (should (= calls 1))))))
(ert-deftest live-completion-uses-existing-idle-session ()
  (let ((session (generate-new-buffer " *rayfall-test-session*")) calls)
    (unwind-protect
        (let ((rayfall-repl-buffer session))
          (with-current-buffer session
            (setq-local rayfall-repl--pending-eval nil)
            (setq-local rayfall-repl--completion-request nil))
          (cl-letf (((symbol-function 'rayfall--repl-live-p) (lambda () t))
                    ((symbol-function 'rayfall--completion-candidates)
                     (lambda (prefix) (push prefix calls) '("take" "tan"))))
            (with-temp-buffer
              (emacs-lisp-mode)
              (insert "ta")
              (let ((capf (rayfall-lsp-live-completion-at-point)))
                (should (equal (nth 2 capf) '("take" "tan")))
                (should (equal (funcall (plist-get (nthcdr 3 capf)
                                                  :annotation-function) "take")
                               " [Rayforce session]")))
              (should (equal calls '("ta")))
              (with-current-buffer session
                (setq-local rayfall-repl--pending-eval t))
              (should-not (rayfall-lsp-live-completion-at-point))
              (should (equal calls '("ta")))
              (with-current-buffer session
                (setq-local rayfall-repl--pending-eval nil))
              (erase-buffer) (insert "bt.")
              (should-not (rayfall-lsp-live-completion-at-point))
              (erase-buffer) (insert "'ta")
              (should-not (rayfall-lsp-live-completion-at-point))
              (erase-buffer) (insert "; ta")
              (should-not (rayfall-lsp-live-completion-at-point))
              (should (equal calls '("ta")))
              (erase-buffer) (insert ".repl.")
              (should (rayfall-lsp-live-completion-at-point))
              (should (equal (car calls) ".repl.")))))
      (kill-buffer session))))
(ert-deftest live-completion-unavailable-session-falls-through ()
  (with-temp-buffer
    (insert "ta")
    (cl-letf (((symbol-function 'rayfall--repl-live-p) (lambda () nil))
              ((symbol-function 'rayfall--completion-candidates)
               (lambda (_) (ert-fail "Must not start or query a session"))))
      (should-not (rayfall-lsp-live-completion-at-point)))))
(ert-deftest find-definition-shows-builtin-signature-when-no-source ()
  (let (shown (rayfall-program "sh"))
    (cl-letf (((symbol-function 'xref-find-definitions)
               (lambda (&rest _) (interactive) (user-error "No definitions found")))
              ((symbol-function 'rayfall-lsp--signature)
               (lambda (name)
                 (and (equal name "min") '("unary" "min" "(min <x>)"))))
              ((symbol-function 'rayfall-lsp--display-inspection)
               (lambda (text &rest _) (setq shown text))))
      (with-temp-buffer
        (emacs-lisp-mode)
        (insert "min")
        (rayfall-lsp-find-definition)
        (should (equal shown "min: builtin (unary)\n(min <x>)"))
        (setq shown nil)
        (erase-buffer) (insert "mine")
        (should-error (rayfall-lsp-find-definition) :type 'user-error)
        (should-not shown)))))
(ert-deftest find-definition-prefers-source-over-signature ()
  (cl-letf (((symbol-function 'xref-find-definitions) (lambda (&rest _) (interactive) 'jumped))
            ((symbol-function 'rayfall-lsp--signature)
             (lambda (_) (ert-fail "Must not query when a definition exists"))))
    (with-temp-buffer (insert "min") (should (eq (rayfall-lsp-find-definition) 'jumped)))))
(ert-deftest signature-never-interpolates-odd-names ()
  (cl-letf (((symbol-function 'rayfall--repl-live-p) (lambda () (ert-fail "queried"))))
    (should-not (rayfall-lsp--signature "min) (exit"))))
(ert-deftest name-at-point-keeps-dotted-builtins ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "(.ipc.open h)")
    (goto-char (point-min))
    (search-forward ".ipc.o")
    (should (equal (rayfall-lsp--name-at-point) ".ipc.open"))
    (goto-char (point-max))
    (should-not (rayfall-lsp--name-at-point))))
(ert-deftest raw-reply-keeps-empty-last-field ()
  (let ((rayfall-lsp--raw-reply t))
    (should (equal (rayfall--parse-completions@rayfall-lsp-raw-reply
                    #'ignore "'vary\n'.ipc.open\n\n")
                   "'vary\n'.ipc.open\n"))))
(ert-deftest parse-signature-accepts-empty-usage-and-rejects-noise ()
  (should (equal (rayfall-lsp--parse-signature "'vary\n'.ipc.open\n\n")
                 '("vary" ".ipc.open" "")))
  (should (equal (rayfall-lsp--parse-signature "'unary\r\n'min\r\n(min <x>)\r\n")
                 '("unary" "min" "(min <x>)")))
  (should-not (rayfall-lsp--parse-signature "'missing\n"))
  (should-not (rayfall-lsp--parse-signature "error: boom\n\n\n")))
(ert-deftest signature-without-a-session-asks-a-fresh-engine ()
  (skip-unless (executable-find "rayforce"))
  (let ((rayfall-program "rayforce") (rayfall-program-arguments nil))
    (cl-letf (((symbol-function 'rayfall--repl-live-p) (lambda () nil)))
      (should (equal (cl-subseq (rayfall-lsp--signature ".ipc.open") 0 2)
                     '("vary" ".ipc.open")))
      (should (string-prefix-p "(min " (nth 2 (rayfall-lsp--signature "min"))))
      (should-not (rayfall-lsp--describe-signature "nosuchname")))))
(ert-deftest find-definition-explains-a-missing-engine ()
  (let ((rayfall-program "no-such-rayforce-binary"))
    (cl-letf (((symbol-function 'xref-find-definitions)
               (lambda (&rest _) (interactive) (user-error "No definitions found")))
              ((symbol-function 'rayfall--repl-live-p) (lambda () nil)))
      (with-temp-buffer
        (emacs-lisp-mode)
        (insert "min")
        (let ((err (should-error (rayfall-lsp-find-definition) :type 'user-error)))
          (should (string-match-p "no-such-rayforce-binary" (cadr err))))))))
(ert-run-tests-batch-and-exit)
