;;; emacs-ui-tests.el --- Inspection checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'eglot)
(defvar company-mode)
(defvar rayfall-repl-buffer nil)
(load-file (expand-file-name "../editors/emacs/rayfall-lsp-ui.el"
                             (file-name-directory load-file-name)))
(ert-deftest inspection-discards-stale-replies ()
  (with-temp-buffer
    (insert "ctx")
    (let (callback displayed)
      (cl-letf (((symbol-function 'eglot-managed-p) (lambda () t))
                ((symbol-function 'eglot-hover-eldoc-function)
                 (lambda (cb &rest _) (setq callback cb)))
                ((symbol-function 'rayfall-lsp--display-inspection)
                 (lambda (&rest _) (setq displayed t))))
        (rayfall-lsp-describe-at-point)
        (backward-char)
        (funcall callback "Parameter: ctx")
        (should-not displayed)
        (rayfall-lsp-describe-at-point)
        (insert "x")
        (funcall callback "Parameter: ctx")
        (should-not displayed)
        (rayfall-lsp-describe-at-point)
        (funcall callback "Parameter: ctx")
        (should displayed)))))
(ert-deftest inspection-popup-is-read-only-display ()
  (let (arguments)
    (provide 'posframe)
    (cl-letf (((symbol-function 'posframe-workable-p) (lambda () t))
              ((symbol-function 'posframe-show) (lambda (&rest args) (setq arguments args)))
              ((symbol-function 'posframe-hide) #'ignore))
      (rayfall-lsp--display-inspection "Dictionary fields: cash" nil)
      (should (equal (plist-get (cdr arguments) :string) "Dictionary fields: cash"))
      (should-not (plist-get (cdr arguments) :accept-focus))
      (should (memq #'rayfall-lsp-hide-inspection pre-command-hook))
      (rayfall-lsp-hide-inspection)
      (should-not (memq #'rayfall-lsp-hide-inspection pre-command-hook)))))
(ert-deftest field-completion-only-triggers-after-code-dot ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (let ((company-mode t) (calls 0))
      (cl-letf (((symbol-function 'eglot-managed-p) (lambda () t))
                ((symbol-function 'rayfall-lsp-complete)
                 (lambda () (setq calls (1+ calls)))))
        (insert "bt.")
        (let ((last-command-event ?.)) (rayfall-lsp-complete-after-dot))
        (should (= calls 1))
        (let ((last-command-event ?a)) (rayfall-lsp-complete-after-dot))
        (should (= calls 1))
        (insert "\n; bt.")
        (let ((last-command-event ?.)) (rayfall-lsp-complete-after-dot))
        (should (= calls 1))))))
(ert-deftest live-completion-uses-existing-idle-session ()
  (let ((session (generate-new-buffer " *rayfall-test-session*")) calls)
    (unwind-protect
        (let ((rayfall-repl-buffer session))
          (with-current-buffer session
            (setq-local rayfall-repl--pending-eval nil)
            (setq-local rayfall-repl--completion-request nil))
          (cl-letf (((symbol-function 'rayfall--repl-live-p) (lambda () t))
                    ((symbol-function 'rayfall--completion-candidates)
                     (lambda (prefix) (push prefix calls) '("take" "tan"))))
            (with-temp-buffer
              (emacs-lisp-mode)
              (insert "ta")
              (let ((capf (rayfall-lsp-live-completion-at-point)))
                (should (equal (nth 2 capf) '("take" "tan")))
                (should (equal (funcall (plist-get (nthcdr 3 capf)
                                                  :annotation-function) "take")
                               " [Rayforce session]")))
              (should (equal calls '("ta")))
              (with-current-buffer session
                (setq-local rayfall-repl--pending-eval t))
              (should-not (rayfall-lsp-live-completion-at-point))
              (should (equal calls '("ta")))
              (with-current-buffer session
                (setq-local rayfall-repl--pending-eval nil))
              (erase-buffer) (insert "bt.")
              (should-not (rayfall-lsp-live-completion-at-point))
              (erase-buffer) (insert "'ta")
              (should-not (rayfall-lsp-live-completion-at-point))
              (erase-buffer) (insert "; ta")
              (should-not (rayfall-lsp-live-completion-at-point))
              (should (equal calls '("ta")))
              (erase-buffer) (insert ".repl.")
              (should (rayfall-lsp-live-completion-at-point))
              (should (equal (car calls) ".repl.")))))
      (kill-buffer session))))
(ert-deftest live-completion-unavailable-session-falls-through ()
  (with-temp-buffer
    (insert "ta")
    (cl-letf (((symbol-function 'rayfall--repl-live-p) (lambda () nil))
              ((symbol-function 'rayfall--completion-candidates)
               (lambda (_) (ert-fail "Must not start or query a session"))))
      (should-not (rayfall-lsp-live-completion-at-point)))))
(ert-run-tests-batch-and-exit)
